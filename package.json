{
  "name": "@gin0606/mdextract",
  "version": "0.0.1",
  "description": "CLI tool to extract and execute code blocks from Markdown files",
  "keywords": [
    "cli",
    "code-blocks",
    "developer-tools",
    "markdown",
    "readme"
  ],
  "license": "ISC",
  "author": "gin0606 (https://github.com/gin0606)",
  "repository": {
    "type": "git",
    "url": "https://github.com/gin0606/mdextract.git"
  },
  "bin": {
    "mdextract": "dist/mdextract.js",
    "mdrun": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings --format=unix",
    "lint:fix": "oxlint --type-aware --deny-warnings --format=unix --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yargs": "^18.0.0",
    "zx": "^8.8.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.2.1",
    "@types/yargs": "^17.0.35",
    "lefthook": "^2.1.0",
    "oxfmt": "^0.28.0",
    "oxlint": "^1.43.0",
    "oxlint-tsgolint": "0.11.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.0"
}
